#!/bin/sh
# tsch launcher for use from any directory. It rebuilds the debug binary in
# this checkout when the source changed, then runs it from the caller's
# directory so relative paths resolve there. The build runs inside the
# checkout so a rust-toolchain file in the caller's project cannot pick the
# compiler; its output goes to stderr so tsch's own stdout stays clean.
root=$(dirname "$(dirname "$(readlink -f "$0")")")
(cd "$root" && cargo build -q >&2) || exit 1
exec "$root/target/debug/tsch" "$@"
